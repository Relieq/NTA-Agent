# Copy to .env (gitignored) and fill in. Real environment variables override these.

# --- required: agent identity / emulator ---
NTA_DISTINCT_ID=            # device distinctId (com.thinkingdata.analyse.xml / lab notes)
NTA_ADB_SERIAL=emulator-5554

# --- optional: server / loop ---
# NTA_SERVER_HOST=nine-hk.twomiles.cn
# NTA_TICK_INTERVAL=5.0
# NTA_LOG_DIR=build/run

# --- brain (B3): OpenAI ---
OPENAI_API_KEY=             # your OpenAI API key (required to enable the brain)
# OPENAI_MODEL=gpt-4o-mini
# NTA_BRAIN_EVERY=60         # ticks between brain calls
# NTA_BRAIN_MAX_CALLS=50     # hard call budget per run
